# disable sort when completing `git checkout` / `git switch`
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:git-switch:*' sort false
# set descriptions format to enable group support
zstyle ':completion:*:descriptions' format '[%d]'
# set list-colors to enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# preview directory's content with eza when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
# preview branches/refs and changed files when completing `git checkout` / `git switch`
zstyle ':fzf-tab:complete:git-(checkout|switch):*' fzf-preview '
  case "$group" in
    (*"modified file"*|*"tree file"*)
      git diff --color=always -- $word 2>/dev/null ;;
    (*"branch name"*|*"remote branch name"*|*"local head"*|*"remote head"*|*"recent branches"*)
      git log --color=always --graph --decorate --oneline -20 $word 2>/dev/null ;;
    (*"commit"*|*"commit tag"*)
      git show --stat --color=always $word 2>/dev/null ;;
  esac'

# preview window sizing for `git checkout` / `git switch`
zstyle ':fzf-tab:complete:git-(checkout|switch):*' fzf-flags \
  --preview-window=right:60%:wrap --height=70%
zstyle ':fzf-tab:complete:git-(checkout|switch):*' fzf-min-height 20

# zsh's _git offers the same ref in several groups (local head, remote head,
# refs decorated in recent commits, DWIM remote branch name), so fzf-tab lists
# it once per group. Keep only the first occurrence of each candidate.
_ftb_dedup() {
  local line word
  local -A seen
  while IFS= read -r line; do
    # keep fzf-tab's header lines (they have no NUL-separated fields)
    [[ $line == *$'\0'* ]] || { print -r -- "$line"; continue }
    word=${${line#*$'\0'}%%$'\0'*}
    (( seen[${(q)word}]++ )) || print -r -- "$line"
  done | command fzf "$@"
}
zstyle ':fzf-tab:complete:git-(checkout|switch):*' fzf-command _ftb_dedup

