# markdown to pdf with pandoc
topdf() {
  if [ -z "$1" ]; then
    echo "Usage: topdf <file> <optional: output file>"
    return
  fi

  local input_file="$1"
  local output_file="${input_file%.*}.pdf"
  if [ -n "$2" ]; then
    output_file="${2:r}.pdf"
  fi

  if [[ "$input_file" == *.md ]]; then
    pandoc "$input_file" -V pagestyle=empty -o "$output_file"
    echo "Converted $input_file to $output_file"
  else
    echo "Unsupported file type. Currently only supports .md files."
  fi
}

# Tail service logs from homebrew.
# Usage: logs <service_name> [tail_args]
# Example: logs caddy -n 100
logs() {
  local name tail_args
  name="$1"
  tail_args=("${@:2}")

  # if name is empty, just print out the directories in /opt/homebrew/var/log/
  if [ -z "$name" ]; then
    eza --icons /opt/homebrew/var/log/
    return
  fi

  if [ -f "/opt/homebrew/var/log/${name}" ]; then
    tail ${tail_args} "/opt/homebrew/var/log/${name}"
  elif [ -f "/opt/homebrew/var/log/${name}.log" ]; then
    tail ${tail_args} "/opt/homebrew/var/log/${name}.log"
  elif [ -d "/opt/homebrew/var/log/${name}" ]; then
    tail ${tail_args} /opt/homebrew/var/log/${name}/*.log
  else
    echo "Log file for $name not found."
  fi
}

# Notify after command finishes
function lmk() {
  local OUTPUT STATUS
  OUTPUT=$("$@")
  if [ $? -eq 0 ]; then
    STATUS="✅ Command Succeeded"
  else
    STATUS="🔴 Command Failed"
  fi
  terminal-notifier -message "$OUTPUT" \
    -title "$STATUS" \
    -subtitle "$@" \
    -message "$OUTPUT" \
    -timeout 5
}

# Start timewarrior with fzf tag selector
# inspired by vimothy chalomet
TIMEW_BIN="$(which timew)"
timew() {
  "$TIMEW_BIN" "$@"
  local ACTIVE="$($TIMEW_BIN get dom.active)"
  if [[ $ACTIVE -eq 0 ]]; then
    sketchybar --trigger timewarrior_updated ACTIVE=0 LABEL=
    return
  fi
  local LABEL="$($TIMEW_BIN get dom.active.tags.1)"
  sketchybar --trigger timewarrior_updated ACTIVE="$ACTIVE" LABEL="$LABEL"
}

tw() {
  local tags choice active arg
  tags=(podmin beebic blog journal learning productivity wasted done)

  if [[ -n "$1" ]]; then
    # Make sure the argument is in the array
    if [[ ${tags[(r)$1]} ]]; then
      choice="$1"
    fi
  fi

  if [[ -z $choice ]]; then
    choice=$(printf "%s\n" "${tags[@]}" | fzf --layout=reverse --preview="$TIMEW_BIN summary day {-1}" --prompt="Select a tag: " --height=10% --border --ansi)
  fi

  if [[ $choice == "" ]]; then
    return 1;
  fi

  if [[ $choice == "done" ]]; then
    timew stop && sketchybar --trigger timewarrior_updated ACTIVE=0 LABEL=
    return
  fi

  active=$(timew get dom.active)
  if [[ $active == 1 ]]; then
    echo "Timewarrior is already tracking time. Please stop the current tracking before starting a new one."
    return 1;
  fi

  timew start "$choice"
}

# Screencasting
ag4 () {
  if [ -z "$1" ]; then
    echo "Convert asciinema to mp4 video."
    echo "Usage: ag4 <input_file>"
    return
  fi
  agg --font-family 'Hasklug Nerd Font Mono' "$1" /tmp/"${1%.*}".gif
  ffmpeg -i /tmp/"${1%.*}".gif -c:v libx264 -pix_fmt yuv420p -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" -y ~/Documents/Screenshots/"${1%.*}".mp4
  rm /tmp/"${1%.*}".gif
}

