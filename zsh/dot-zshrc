## Homebrew
brew() {
  if [ -z "$1" ]; then
    local pkg=$(brew formulae | fzf --border --border-label ' Enter to install Homebrew package ' --preview 'sleep 1 && echo "" && brew info {}')
    if [[ $pkg ]]; then
      brew install "$pkg"
      brew_sync
    fi
  else
    command brew "$@"
    if [[ $1 == "install" || $1 == "remove" || $1 == "uninstall" ]]; then
      brew_sync
    fi
  fi
}

unbrew() {
  local pkg=$(brew list --installed-on-request | fzf --border --border-label ' Enter to remove Homebrew package ' --preview 'sleep 1 && echo "" && brew info {}')
  if [[ $pkg ]]; then
    command brew remove "$pkg"
    brew_sync
  fi
}

brew_sync() {
    echo "Updating Brewfile..."
    command brew bundle dump --global --force --no-vscode
}



