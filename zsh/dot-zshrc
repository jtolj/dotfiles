# fzf to search for ssh hosts - from https://kaeruct.github.io/posts/2024/10/10/ssh-config-hostnames/
ssh () {
  if [[ $# -gt 0 ]]; then
    command ssh "$@"
  else
    local server
      server=$(grep -E '^Host ' ~/.ssh/config | awk '{print $2}' | fzf --preview "ssh -Gtt \$(echo {}) |head -n +10")
      if [[ -n $server ]] then
        command ssh $server
      fi
  fi
}

